{
  "name": "downbili",
  "version": "0.4.1",
  "description": "下载bilibili视频",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "bin": {
    "downbili": "dist/cli.js"
  },
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "rimraf dist && pnpm build:rollup && pnpm build:types",
    "build:rollup": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "prepublishOnly": "pnpm build",
    "tsx": "tsx ./demo.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gartotr/downbili.git"
  },
  "keywords": [
    "bilibili",
    "B站",
    "下载B站视频"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gartotr/downbili/issues"
  },
  "homepage": "https://github.com/gartotr/downbili#readme",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.1.2",
    "commander": "^15.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "single-line-log": "^1.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^18.13.0",
    "prettier": "^2.8.4",
    "rimraf": "^6.0.1",
    "rollup": "^3.21.4",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "package.json",
    "readme.md",
    "dist/",
    "LICENSE"
  ]
}